{
  "rewrites": [
    {
      "source": "/cms",
      "destination": "/cms/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/scenario",
      "destination": "/scenario/index.html"
    },
    {
      "source": "/demo-accounts",
      "destination": "/demo-accounts/index.html"
    },
    {
      "source": "/demo-accounts/",
      "destination": "/demo-accounts/index.html"
    },
    {
      "source": "/asp-cms",
      "destination": "/asp-cms/index.html"
    },
    {
      "source": "/asp-cms/",
      "destination": "/asp-cms/index.html"
    },
    {
      "source": "/asp",
      "destination": "/asp/index.html"
    },
    {
      "source": "/asp/",
      "destination": "/asp/index.html"
    },
    {
      "source": "/asp-sim",
      "destination": "/asp-sim/index.html"
    },
    {
      "source": "/asp-sim/",
      "destination": "/asp-sim/index.html"
    },
    {
      "source": "/asp-dev",
      "destination": "/asp-dev/index.html"
    },
    {
      "source": "/asp-dev/",
      "destination": "/asp-dev/index.html"
    },
    {
      "source": "/flutter",
      "destination": "/flutter-web/index.html"
    },
    {
      "source": "/flutter/",
      "destination": "/flutter-web/index.html"
    },
    {
      "source": "/flutter/:path*",
      "destination": "/flutter-web/:path*"
    },
    {
      "source": "/",
      "destination": "/cms/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/lp-merchants",
      "schedule": "0 19 * * *"
    }
  ],
  "functions": {
    "api/asp/*.js": {
      "maxDuration": 30
    },
    "api/asp-mock/*.js": {
      "maxDuration": 30
    },
    "api/asp-admin/*.js": {
      "maxDuration": 30
    }
  }
}
